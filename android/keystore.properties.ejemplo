# Copia este fichero a `keystore.properties` y rellénalo. El original está
# excluido del repositorio a propósito.
#
# El almacén se crea una vez, y conviene guardarlo fuera del proyecto y con
# copia de seguridad:
#
#   keytool -genkeypair -v \
#     -keystore ~/claves/escaparate-subida.jks \
#     -alias escaparate -keyalg RSA -keysize 4096 -validity 10000
#
# Con Play App Signing activado, esta es la clave de SUBIDA: si se pierde,
# Google puede darte otra. La clave con la que se firma lo que instala la gente
# la guarda Google. Sin Play App Signing, perder esto es perder la app.

storeFile=/home/jhon/claves/escaparate-subida.jks
storePassword=
keyAlias=escaparate
keyPassword=
