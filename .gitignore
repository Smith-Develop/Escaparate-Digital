# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla sí: no lleva ningún secreto y es lo que explica qué variables
# hacen falta. Sin esta excepción, quien clone el repositorio no tiene por dónde
# empezar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Armario Virtual
/prisma/dev.db
/prisma/dev.db-journal
/public/uploads/*
!/public/uploads/.gitkeep
