# ── En Coolify, como variables de COMPILACIÓN ──────────────────────────────
#
# Las tres se resuelven al construir la imagen, no al arrancarla: acaban dentro
# del JavaScript que descarga el navegador. Si las cambias hay que reconstruir;
# reiniciar el contenedor no sirve de nada.
#
# En Coolify, al añadirlas al recurso de Escaparate, marca la casilla de
# «Build Variable». Si solo están como variables de ejecución, la app se
# desplegará pero se abrirá diciendo que faltan.

# La URL de la API de Supabase: el dominio del servicio, NO la cadena de
# conexión a PostgreSQL (`postgresql://…`), que es otra cosa.
NEXT_PUBLIC_SUPABASE_URL="https://supabase-kong-xxxx.tu-dominio.com"

# La clave anónima. Es un JWT y es PÚBLICA por diseño: viaja dentro de la app,
# así que cualquiera que la use puede leerla. No es un descuido: lo que protege
# los datos son las políticas de seguridad por filas de la base, no el secreto
# de esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Las tablas viven en un esquema propio, porque el Supabase está compartido con
# otras aplicaciones. PostgREST solo expone los esquemas que le digas: en
# Coolify, el servicio `rest` necesita
#   PGRST_DB_SCHEMAS=public,storage,graphql_public,app_escaparate
NEXT_PUBLIC_SUPABASE_SCHEMA="app_escaparate"

# ── Solo en tu máquina. NUNCA en Coolify ───────────────────────────────────
#
# La clave de servicio se salta la seguridad por filas entera: quien la tenga
# lee y borra los datos de cualquier usuario de la instancia. Solo la usan los
# scripts de `scripts/` que se ejecutan desde tu ordenador (cargar datos de
# ejemplo, migrar el armario antiguo, aplicar migraciones).
#
# Va en `.env.local`, que el `.gitignore` ya excluye. Que no acabe en el
# repositorio, ni en el contenedor, ni en un chat.
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# El `JWT_SECRET` de Supabase (con el que se firman las dos claves de arriba)
# NO tiene que aparecer aquí ni en el recurso de Escaparate: pertenece al
# recurso de Supabase, que ya lo tiene.
